{
  "manifest_version": 3,
  "name": "查找数据手册 (Look for Datasheet)",
  "version": "1.4.0",
  "description": "选中元器件型号后，通过浮动按钮或右键菜单打开 semiee.com 或 LCSC 搜索结果页",
  "permissions": [
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
